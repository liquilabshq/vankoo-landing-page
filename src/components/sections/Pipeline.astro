---
import {useCopy, normalizeLocale} from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import type {IconName} from '../ui/icons';

const copy = useCopy(normalizeLocale(Astro.currentLocale));
const {pipeline} = copy;

/**
 * One icon per milestone, and one per dead end.
 *
 * All from the same Lucide generation the design system is pinned to. `gavel`
 * for the auction rather than a coin: what happens there is bidding, not paying.
 */
const stepIcons: IconName[] = ['file-text', 'scan-line', 'badge-check', 'circle-check-big', 'gavel'];
const exceptionIcons: IconName[] = ['triangle-alert', 'circle-alert', 'circle-x'];

/**
 * The colour of an exception says who has to act, exactly as it does inside the
 * product: amber when a person is needed, grey and red when the road ends.
 */
const exceptionTone = ['text-warning', 'text-fg-muted', 'text-error'];
---

<section id="como-funciona" class="relative isolate py-20 lg:py-28">
    <div class="shell">
        <SectionHeading
            eyebrow={pipeline.eyebrow}
            title={pipeline.title}
            lead={pipeline.lead}
            class="reveal max-w-3xl"
        />

        {/*
          The five milestones. On a wide screen they read left to right as a
          track; stacked on a phone, where a five-column track would be four
          columns too many.
        */}
        <ol class="reveal-stagger mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-5 lg:gap-3">
            {
                pipeline.steps.map((step, index) => (
                    <li class="step-card group relative flex flex-col gap-4 rounded-xl border border-line-subtle bg-surface-raised p-5 transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-line hover:shadow-elevation-2">
                        <span class="flex items-center justify-between">
                            <span class="flex size-10 items-center justify-center rounded-lg bg-ai-bg text-ai transition-colors duration-300 group-hover:bg-action group-hover:text-on-action">
                                <Icon name={stepIcons[index]} class="size-5" />
                            </span>
                            <span class="text-[length:var(--vk-text-caption-size)] font-semibold text-fg-muted tabular-nums">
                                0{index + 1}
                            </span>
                        </span>
                        <span class="flex flex-col gap-1.5">
                            <span class="type-card text-fg">{step.name}</span>
                            <span class="type-eyebrow text-fg-secondary">{step.who}</span>
                        </span>
                        <span class="text-fg-secondary">{step.detail}</span>
                    </li>
                ))
            }
        </ol>

        {/*
          The three ways an invoice stops. A landing page that only draws the
          happy path is selling something; naming the dead ends is what makes the
          rest believable — and these are real states in the Invoicing service,
          not hypotheticals.
        */}
        <div class="reveal mt-12 rounded-xl border border-line-subtle bg-surface-sunken p-6 lg:p-8">
            <p class="type-card text-fg">{pipeline.exceptionsTitle}</p>
            <ul class="mt-5 grid gap-5 sm:grid-cols-3">
                {
                    pipeline.exceptions.map((exception, index) => (
                        <li class="flex gap-3">
                            <Icon name={exceptionIcons[index]} class={`mt-0.5 size-5 shrink-0 ${exceptionTone[index]}`} />
                            <span>
                                <span class="block font-semibold text-fg">{exception.name}</span>
                                <span class="block text-fg-secondary">{exception.detail}</span>
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
