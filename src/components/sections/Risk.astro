---
import {useCopy, normalizeLocale} from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import type {IconName} from '../ui/icons';

const copy = useCopy(normalizeLocale(Astro.currentLocale));
const {risk, guarantees} = copy;

const guaranteeIcons: IconName[] = ['badge-check', 'wallet', 'lock'];

/**
 * The three grades, in the tokens the design system reserves for exactly this.
 *
 * `risk/a|b|c` is the platform's only scoring vocabulary, so the letters here
 * are the same colours a screen inside the product would paint them.
 */
const tones = [
    {fg: 'text-risk-a', bg: 'bg-risk-a-bg', ring: 'ring-risk-a/25'},
    {fg: 'text-risk-b', bg: 'bg-risk-b-bg', ring: 'ring-risk-b/25'},
    {fg: 'text-risk-c', bg: 'bg-risk-c-bg', ring: 'ring-risk-c/25'}
];
---

<section class="relative isolate py-20 lg:py-28">
    <div class="shell">
        <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
            <SectionHeading title={risk.title} lead={risk.lead} class="reveal" />

            <ul class="reveal-stagger grid gap-4 sm:grid-cols-3">
                {
                    risk.grades.map((grade, index) => (
                        <li class="group flex flex-col gap-4 rounded-xl border border-line-subtle bg-surface-raised p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-elevation-2">
                            <span
                                class:list={[
                                    'flex size-14 items-center justify-center rounded-lg font-display text-[length:var(--vk-text-h2-size)] font-bold ring-1 transition-transform duration-300 group-hover:scale-105',
                                    tones[index].bg,
                                    tones[index].fg,
                                    tones[index].ring
                                ]}
                            >
                                {grade.grade}
                            </span>
                            <span class="font-semibold text-fg">{grade.title}</span>
                            <span class="text-fg-secondary">{grade.detail}</span>
                        </li>
                    ))
                }
            </ul>
        </div>

        {/* Left-aligned under the heading it belongs to. It used to be
            `lg:text-right` beneath a two-column grid it does not span, so it
            lined up with nothing. */}
        <p class="reveal mt-8 max-w-[58ch] text-[length:var(--vk-text-caption-size)] text-fg-secondary">
            {risk.note}
        </p>

        {/*
          What is left of the «Confianza» section, as a strip rather than as four
          cards of its own.

          Three of those four items are on every fintech landing page ever built,
          and a full section with its own heading claimed they were the argument.
          They are not: they are the floor. So they ride here as supporting
          detail, in a layout family the page does not use anywhere else — a row
          under one hairline, no borders, no tiles, no cards.
        */}
        <div class="reveal mt-16 border-t border-line-subtle pt-8">
            {/* A plain small heading, not the uppercase eyebrow style: this page
                already carries more of those than it earns, and the strip does
                not need a seventh. */}
            <p class="font-semibold text-fg">{guarantees.title}</p>
            <ul class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-3">
                {
                    guarantees.items.map((item, index) => (
                        <li class="flex gap-3">
                            <Icon name={guaranteeIcons[index]} class="mt-0.5 size-5 shrink-0 text-green-finance" />
                            <span>
                                <span class="block font-semibold text-fg">{item.title}</span>
                                <span class="block text-[length:var(--vk-text-caption-size)] text-fg-secondary">
                                    {item.detail}
                                </span>
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
