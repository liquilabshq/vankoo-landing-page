---
import {useCopy, normalizeLocale} from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import DotField from '../decor/DotField.astro';
import type {IconName} from '../ui/icons';

const copy = useCopy(normalizeLocale(Astro.currentLocale));
const {security} = copy;

const icons: IconName[] = ['landmark', 'badge-check', 'wallet', 'lock'];
---

<section class="relative isolate overflow-hidden bg-surface-sunken py-20 lg:py-28">
    <DotField fade="radial" class="opacity-50" />

    <div class="shell relative">
        <SectionHeading
            eyebrow={security.eyebrow}
            title={security.title}
            lead={security.lead}
            align="center"
            class="reveal mx-auto max-w-3xl"
        />

        <ul class="reveal-stagger mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
                security.items.map((item, index) => (
                    <li class="group relative flex flex-col gap-4 overflow-hidden rounded-xl border border-line-subtle bg-surface-raised p-6">
                        {/* A quiet green wash that grows out of the icon on hover.
                            Decoration is allowed to be atmosphere here; what it is
                            not allowed to do is sit behind the text, which is why
                            it stops well short of it. */}
                        <span class="pointer-events-none absolute -top-16 -right-16 size-32 rounded-full bg-action/10 opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100" />

                        <span class="flex size-11 items-center justify-center rounded-lg bg-surface-sunken text-green-finance ring-1 ring-line-subtle">
                            <Icon name={icons[index]} class="size-5" />
                        </span>
                        <span class="font-semibold text-fg">{item.title}</span>
                        <span class="text-fg-secondary">{item.detail}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
