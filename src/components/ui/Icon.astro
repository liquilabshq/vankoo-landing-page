---
import {ICONS, type IconName} from './icons';

/**
 * One Lucide glyph, inlined.
 *
 * Decorative by default: an icon that sits next to its own label is noise to a
 * screen reader, so it is hidden unless a `label` is passed, which is the case
 * where the icon is carrying the meaning on its own.
 */
interface Props {
    name: IconName;
    class?: string;
    label?: string;
    strokeWidth?: number;
}

const {name, class: className = 'size-5', label, strokeWidth = 2} = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    set:html={ICONS[name]}
/>
