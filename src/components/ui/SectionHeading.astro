---
/**
 * The eyebrow / heading / lead trio every section opens with.
 *
 * All three styles are Figma's: `Landing/Eyebrow` in Poppins at +10% tracking
 * and uppercase, `Landing/H2` in Poppins at -1%, `Landing/Lead` in Plus Jakarta
 * Sans. The eyebrow's uppercasing is a CSS transform rather than typed capitals,
 * so a screen reader still reads a word and not a row of letters.
 */
interface Props {
    eyebrow: string;
    title: string;
    lead?: string;
    align?: 'start' | 'center';
    class?: string;
}

const {eyebrow, title, lead, align = 'start', class: className = ''} = Astro.props;
---

<div
    class:list={[
        'flex flex-col gap-4',
        align === 'center' ? 'items-center text-center' : 'items-start',
        className
    ]}
>
    <span class="type-eyebrow inline-flex items-center gap-2 text-green-finance">
        <span class="inline-block size-1.5 rounded-full bg-action"></span>
        {eyebrow}
    </span>
    <h2 class="type-section max-w-[20ch] text-fg">{title}</h2>
    {lead && <p class:list={['type-lead max-w-[58ch]', align === 'center' && 'mx-auto']}>{lead}</p>}
</div>
